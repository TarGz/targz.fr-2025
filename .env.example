# Shopify myshopify.com domain (without https://)
SHOPIFY_STORE_URL=targzart.myshopify.com

# Shopify Admin API access token (starts with shpat_)
# Get from: Shopify admin > Settings > Apps > Develop apps > your app > API credentials
SHOPIFY_ACCESS_TOKEN=shpat_your_token_here

# Stripe Secret Key
# Get this from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
